# Pico Claw environment variables
#
# Copy this file to `.env` (already gitignored) and fill in your values.
# The application loads `.env` from its working directory at startup.
# Variables already set in the real environment always win over `.env`.
#
# Every other setting lives in config/config.json -- provider endpoint
# (`base_url`), model, teacher routing (`routing_teacher_base_url`,
# `routing_teacher_model`, `routing_local_only`,
# `routing_teacher_max_request_bytes`), and budgets. See
# docs/configuration.md.
#
# The Telegram channel is optional and disabled by default; see
# docs/telegram.md.

# Required for `chat` and `serve` (optional for `status`, `proposals`, and
# `channel`): the API key of the primary provider. The same key is used for
# the teacher provider when teacher routing is configured. The value is
# never printed or logged.
PICO_CLAW_API_KEY=your-api-key-here

# Values may be quoted. Comments must be on their own line:
# PICO_CLAW_API_KEY="your-api-key-here"

# --- Telegram channel (optional) -------------------------------------------
# `pico_claw channel telegram` polls Telegram and routes each allowed chat
# through the same agent as CLI chat. Placeholders only -- never commit a
# real bot token.

# Enable the channel. Truthy values: 1, true, yes, on (case-insensitive).
TELEGRAM_ENABLED=true

# Bot token from @BotFather. Required when TELEGRAM_ENABLED is truthy.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Comma-separated numeric Telegram user ids allowed to talk to the bot.
# Empty or omitted denies everyone; a denied sender only receives a fixed
# hint that echoes their own id so the owner can add it here.
TELEGRAM_ALLOWED_USERS=123456789
